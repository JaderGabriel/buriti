APP_NAME=BURITI
APP_ENV=local
APP_KEY=
APP_DEBUG=false
# Em desenvolvimento local pode ser true. Em produção: false e LOG_LEVEL=warning|error
# Document root = public/. Sem /public no path — senão route:cache parte a home (GET / → 405).
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

# Horário oficial do Brasil (GMT-3)
APP_TIMEZONE=America/Sao_Paulo

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=buriti_site
DB_USERNAME=buriti
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Em produção com HTTPS: SESSION_SECURE_COOKIE=true
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="contato@buriti.dev.br"
MAIL_FROM_NAME="${APP_NAME}"
# IMAP usa o mesmo login/senha do SMTP (painel E-mail). Host vazio deriva do SMTP.

VITE_APP_NAME="${APP_NAME}"

ADMIN_NAME="Admin BURI-TI"
ADMIN_EMAIL="admin@buriti.dev.br"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"

# Credenciais de Google, Trello, Notion e Telegram NÃO devem ir para o Git.
# Grave-as cifradas no painel: Admin → Configurações (Google) e Admin → Integrações.
# As chaves abaixo são só fallback de bootstrap (opcional) até existirem na base.
GOOGLE_REDIRECT_URI="${APP_URL}/admin/google/callback"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
TRELLO_API_KEY=
TRELLO_TOKEN=
NOTION_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
